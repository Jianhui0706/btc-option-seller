# 复制为 .env 并填写，.env 不进 git
DERIBIT_ENV=testnet
DERIBIT_TESTNET_CLIENT_ID=
DERIBIT_TESTNET_CLIENT_SECRET=
DERIBIT_MAINNET_CLIENT_ID=
DERIBIT_MAINNET_CLIENT_SECRET=
# TradingView JSON 中的 passphrase（只用于 webhook）
WEBHOOK_PASSPHRASE=replace-with-a-long-random-value
# 用于拒绝误发到其他账户的 Alert；需与监控台复制出的 JSON 一致
TRADING_ACCOUNT_NAME=account_1
