# ⚠ 本配置对公网完全开放，仅限 testnet 模拟盘。
#
# 后端没有任何鉴权（见 tests/test_auth.py：面板请求不校验令牌），此前是靠
# 这里的单 IP 白名单挡住 /control/*。白名单已按需求取消 —— 家宽动态 IP 一漂
# 就把人锁在外面，测试期间不值得。
#
# 取消后任何人只要访问到本域名，都能：
#   - 读取账户权益、持仓、全部交易与事件历史
#   - POST /control/force_close   触发全账户强平
#   - POST /control/trading       开关新开仓
#
# 上 mainnet 前必须先加鉴权，二选一：
#   1) Caddy basic auth（最省事，浏览器记住密码，任何 IP 都能进）：
#        caddy hash-password --plaintext '你的密码'
#      再把下面 handle 块换成：
#        basic_auth { 你的用户名 <上面输出的 hash> }
#        reverse_proxy 127.0.0.1:8310
#   2) 按 docs 的公网鉴权加固设计实现 DASHBOARD_TOKEN + X-Auth
# test_cloud_deployment.py 会拦住带着本配置上实盘。

btc-option-seller-43-160-202-151.sslip.io {
    encode zstd gzip

    # webhook 必须对 TradingView 开放（其自身用 passphrase 鉴权）
    @tradingview_webhook path /webhook/tradingview /webhook/signal
    handle @tradingview_webhook {
        reverse_proxy 127.0.0.1:8310
    }

    # 面板与管理接口：testnet 期间不限制来源
    handle {
        reverse_proxy 127.0.0.1:8310
    }
}
