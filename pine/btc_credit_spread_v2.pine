//@version=6
// BTC 期权卖方策略 V2 — TradingView 信号端
//
// 挂 3 分钟图运行（规范第二节）；通过 request.security 读取：
//   BTC 2小时数据  → 开仓信号（布林带 + 阳/阴线 + CCI + HV 分位）
//   DVOL 12小时数据 → 开仓档位（730天窗口分位）与滚动退出（60天窗口30分位）
// 所有 security 调用取 [1] + lookahead_on（标准防重绘写法，只用已收盘 bar）。
//
// ⚠ 待确认口径（占位默认值，请按原策略核对）：布林带周期/倍数、HV 计算窗口与分位窗口。
indicator("BTC期权卖方V2信号", overlay = false)

// ---------------------------------------------------------------- 参数（规范第四节）
grpEntry = "DVOL 开仓档位"
dvol_entry_level_1 = input.float(40.0, "dvol_entry_level_1 (%)", group = grpEntry, minval = 0, maxval = 100)
dvol_entry_level_2 = input.float(60.0, "dvol_entry_level_2 (%)", group = grpEntry, minval = 0, maxval = 100)
dvol_entry_level_3 = input.float(85.0, "dvol_entry_level_3 (%)", group = grpEntry, minval = 0, maxval = 100)
dvol_entry_window_days = input.int(730, "dvol_entry_window_days", group = grpEntry, minval = 30)

grpExit = "DVOL 平仓"
dvol_exit_window_days = input.int(60, "dvol_exit_window_days", group = grpExit, minval = 10)
dvol_exit_percentile = input.float(30.0, "dvol_exit_percentile (%)", group = grpExit, minval = 1, maxval = 99)

grpSig = "开仓信号（2小时）"
boll_len = input.int(20, "布林带周期 ⚠待核对", group = grpSig, minval = 2)
boll_mult = input.float(2.0, "布林带标准差倍数 ⚠待核对", group = grpSig, minval = 0.1)
cci_len = input.int(20, "CCI 周期", group = grpSig, minval = 2)
cci_max = input.float(101.0, "abs(CCI) 上限", group = grpSig)
hv_len = input.int(20, "HV 计算窗口(2h bar数) ⚠待核对", group = grpSig, minval = 5)
hv_pctl_window = input.int(252, "HV 分位窗口(2h bar数) ⚠待核对", group = grpSig, minval = 20)
hv_pctl_min = input.float(30.0, "HV 分位下限 (%)", group = grpSig)

grpMisc = "执行与对冲参数（透传后端）"
group_split_count = input.int(4, "group_split_count", group = grpMisc, minval = 1)
delta_account_risk_pct = input.float(2.0, "delta_account_risk_pct (%)", group = grpMisc)
delta_trigger_pct = input.float(10.0, "delta_trigger_pct (%)", group = grpMisc)
call_hedge_release_pct = input.float(98.0, "call_hedge_release_pct (%)", group = grpMisc)
put_hedge_release_pct = input.float(102.0, "put_hedge_release_pct (%)", group = grpMisc)

grpWh = "Webhook"
passphrase = input.string("", "passphrase（与后端 WEBHOOK_SECRET 一致）", group = grpWh)
strategy_name = input.string("BTC_OPTION_SELLER_V2", "strategy", group = grpWh)

// ---------------------------------------------------------------- 参数有效性（规范第四.1节）
cfgOk = dvol_entry_level_1 < dvol_entry_level_2 and dvol_entry_level_2 < dvol_entry_level_3
// 配置错误：停止发送开仓信号 + 图面红色警示

// ---------------------------------------------------------------- 2小时数据（防重绘：[1] + lookahead_on）
f_hv() =>
    // 年化历史波动率(%)：hv_len 根 2h 对数收益率标准差 × sqrt(365*12)
    r = math.log(close / close[1])
    ta.stdev(r, hv_len) * math.sqrt(365 * 12) * 100

f_pctl(src, len) =>
    // 中位秩分位 0~100（与后端 percentile_rank 对齐）
    less = 0
    lessEq = 0
    for i = 0 to len - 1
        v = src[i]
        if v < src
            less += 1
        if v <= src
            lessEq += 1
    100.0 * (less + lessEq) / (2 * len)

[c2, o2, h2, l2, bbU2, bbL2, cci2, hvPct2, t2] = request.security(syminfo.tickerid, "120",
     [close[1], open[1], high[1], low[1],
      (ta.sma(close, boll_len) + boll_mult * ta.stdev(close, boll_len))[1],
      (ta.sma(close, boll_len) - boll_mult * ta.stdev(close, boll_len))[1],
      ta.cci(close, cci_len)[1],
      f_pctl(f_hv(), hv_pctl_window)[1],
      time[1]],
     lookahead = barmerge.lookahead_on)

// ---------------------------------------------------------------- 12小时 DVOL
[dvol12, tDvol] = request.security("DERIBIT:DVOL", "720", [close[1], time[1]],
     lookahead = barmerge.lookahead_on)

// 自维护已完成 12h bar 队列（730天 × 2 根/天）
entryWinBars = dvol_entry_window_days * 2
exitWinBars = dvol_exit_window_days * 2
var array<float> dvolHist = array.new_float()
var int lastDvolT = na
newDvolBar = not na(tDvol) and (na(lastDvolT) or tDvol != lastDvolT)
if newDvolBar and not na(dvol12)
    array.push(dvolHist, dvol12)
    lastDvolT := tDvol
    if array.size(dvolHist) > entryWinBars
        array.shift(dvolHist)

// DVOL 开仓分位（最近 entryWinBars 个已完成值的中位秩）
f_arr_pctl(arr, cnt) =>
    n = math.min(array.size(arr), cnt)
    if n < 2
        float(na)
    else
        cur = array.get(arr, array.size(arr) - 1)
        less = 0
        lessEq = 0
        for i = array.size(arr) - n to array.size(arr) - 1
            v = array.get(arr, i)
            if v < cur
                less += 1
            if v <= cur
                lessEq += 1
        100.0 * (less + lessEq) / (2 * n)

dvolPct = f_arr_pctl(dvolHist, entryWinBars)

// 档位（规范第四.1节）：<L1 不开仓；L1~L2 → 1；L2~L3 → 2；>L3 → 3
tier = na(dvolPct) ? 0 : dvolPct < dvol_entry_level_1 ? 0 :
     dvolPct < dvol_entry_level_2 ? 1 : dvolPct < dvol_entry_level_3 ? 2 : 3

// DVOL 滚动退出（规范第八节）：当前完成值 < 之前 exitWinBars 个值的 exit 分位
f_exit_level() =>
    n = array.size(dvolHist)
    if n < exitWinBars + 1
        float(na)
    else
        ref = array.new_float()
        for i = n - exitWinBars - 1 to n - 2
            array.push(ref, array.get(dvolHist, i))
        array.sort(ref, order.ascending)
        pos = dvol_exit_percentile / 100.0 * (exitWinBars - 1)
        lo = math.floor(pos)
        hi = math.min(lo + 1, exitWinBars - 1)
        frac = pos - lo
        array.get(ref, lo) * (1 - frac) + array.get(ref, hi) * frac

dvolExitLevel = f_exit_level()
dvolExitHit = newDvolBar and not na(dvolExitLevel) and dvol12 < dvolExitLevel

// ---------------------------------------------------------------- 开仓条件（规范第五节，每根2h bar至多一枚）
newBar2h = not na(t2) and (na(t2[1]) or t2 != t2[1])
hvOk = not na(hvPct2) and hvPct2 >= hv_pctl_min
cciOk = not na(cci2) and math.abs(cci2) < cci_max
tierOk = tier >= 1

putSignal = newBar2h and cfgOk and tierOk and hvOk and cciOk and
     not na(bbL2) and l2 < bbL2 and c2 > o2          // 最低价跌破下轨 + 阳线
callSignal = newBar2h and cfgOk and tierOk and hvOk and cciOk and
     not na(bbU2) and h2 > bbU2 and c2 < o2          // 最高价突破上轨 + 阴线

var int lastSigT = na
canFire = na(lastSigT) or t2 != lastSigT             // 每根 2h bar 至多一枚信号

// ---------------------------------------------------------------- Webhook JSON（规范第五节）
f_open_json(spreadType) =>
    sid = strategy_name + "_" + spreadType + "_" + str.tostring(t2)
    "{" +
     "\"passphrase\":\"" + passphrase + "\"," +
     "\"event\":\"OPEN_REQUEST\"," +
     "\"strategy\":\"" + strategy_name + "\"," +
     "\"spread_type\":\"" + spreadType + "\"," +
     "\"signal_id\":\"" + sid + "\"," +
     "\"btc_price\":" + str.tostring(c2, "#.#") + "," +
     "\"hv_percentile\":" + str.tostring(hvPct2 / 100.0, "#.####") + "," +
     "\"dvol_percentile\":" + str.tostring(dvolPct / 100.0, "#.####") + "," +
     "\"dvol_tier\":" + str.tostring(tier) + "," +
     "\"group_split_count\":" + str.tostring(group_split_count) + "," +
     "\"delta_account_risk_pct\":" + str.tostring(delta_account_risk_pct / 100.0, "#.####") + "," +
     "\"delta_trigger_pct\":" + str.tostring(delta_trigger_pct / 100.0, "#.####") + "," +
     "\"call_hedge_release_pct\":" + str.tostring(call_hedge_release_pct / 100.0, "#.####") + "," +
     "\"put_hedge_release_pct\":" + str.tostring(put_hedge_release_pct / 100.0, "#.####") +
     "}"

f_exit_json() =>
    sid = strategy_name + "_EXIT_DVOL_" + str.tostring(tDvol)
    "{" +
     "\"passphrase\":\"" + passphrase + "\"," +
     "\"event\":\"EXIT_DVOL\"," +
     "\"strategy\":\"" + strategy_name + "\"," +
     "\"signal_id\":\"" + sid + "\"," +
     "\"dvol_value\":" + str.tostring(dvol12, "#.##") + "," +
     "\"dvol_exit_level\":" + str.tostring(dvolExitLevel, "#.##") +
     "}"

if putSignal and canFire
    alert(f_open_json("PUT_CREDIT"), alert.freq_once_per_bar)
    lastSigT := t2
if callSignal and canFire
    alert(f_open_json("CALL_CREDIT"), alert.freq_once_per_bar)
    lastSigT := t2
if dvolExitHit and cfgOk
    alert(f_exit_json(), alert.freq_once_per_bar)

// ---------------------------------------------------------------- 图面展示
plot(dvolPct, "DVOL分位%", color = color.orange)
plot(hvPct2, "HV分位%", color = color.teal)
hline(30, "HV下限30", color = color.gray, linestyle = hline.style_dotted)
bgcolor(cfgOk ? na : color.new(color.red, 70))

var table tb = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "配置", text_size = size.small)
    table.cell(tb, 1, 0, cfgOk ? "OK" : "档位配置错误 L1<L2<L3！",
         text_color = cfgOk ? color.green : color.red, text_size = size.small)
    table.cell(tb, 0, 1, "DVOL分位", text_size = size.small)
    table.cell(tb, 1, 1, na(dvolPct) ? "样本不足" : str.tostring(dvolPct, "#.#") + "%",
         text_size = size.small)
    table.cell(tb, 0, 2, "档位", text_size = size.small)
    table.cell(tb, 1, 2, str.tostring(tier), text_size = size.small)
    table.cell(tb, 0, 3, "HV分位(2h)", text_size = size.small)
    table.cell(tb, 1, 3, na(hvPct2) ? "…" : str.tostring(hvPct2, "#.#") + "%",
         text_size = size.small)
    table.cell(tb, 0, 4, "CCI(2h)", text_size = size.small)
    table.cell(tb, 1, 4, na(cci2) ? "…" : str.tostring(cci2, "#.#"), text_size = size.small)
    table.cell(tb, 0, 5, "DVOL样本", text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(array.size(dvolHist)) + "/" +
         str.tostring(entryWinBars), text_size = size.small)
    table.cell(tb, 0, 6, "退出阈值", text_size = size.small)
    table.cell(tb, 1, 6, na(dvolExitLevel) ? "样本不足" : str.tostring(dvolExitLevel, "#.##"),
         text_size = size.small)
